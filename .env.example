# Public PostHog browser configuration
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Alibaba Cloud Model Studio (Wan video)
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=intl

# AI endpoints (api/coach.ts, api/program.ts, api/playbook.ts, api/niche-profiles/resolve.ts): Claude through OpenRouter
OPENROUTER_API_KEY=
# Optional model overrides (defaults: anthropic/claude-opus-5.5 and anthropic/claude-sonnet-5.5)
OPENROUTER_MODEL_SMART=
OPENROUTER_MODEL_FAST=
# RevenueCat secret API key (v1): checks each caller's plan (Premium / Ultimate)
REVENUECAT_SECRET_KEY=
# Upstash Redis REST: counts AI Coach messages per account (Free 3, Premium 10/month, Ultimate 300/month)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: Vaulten API used to verify the app's bearer token
VAULTEN_API_URL=https://api.vaulten-staging.jerseycollection.shop/api/v1/
